<?xml version="1.0" encoding="utf-8"?>
<openerp>
	<data>

		<record model="ir.ui.view" id="poweremail_send_wizard_form">
			<field name="name">poweremail.send.wizard.form</field>
			<field name="model">poweremail.send.wizard</field>
			<field name="type">form</field>
			<field name="arch" type="xml">
				<form string="Send email">
					<group attrs="{'invisible':[('state','!=','send_type')]}">
                        <card title="Information" icon="info-circle">
                            <label string="Select this option to send one email for all selected records. Its optional attachment will be generated as a single file. Otherwise, one email and its optional attachment will be generated for each record." colspan="8"/>
                            <field name="single_email" widget="switch" colspan="4"/>
                        </card>
                        <group col="10">
                            <label colspan="6"/>
                            <button icon="gtk-cancel" special="cancel" string="Close" danger="1" colspan="2"/>
                            <button icon="chevron-right" name="compute_second_step" string="Continue" type="object" primary="1" colspan="2"/>
                        </group>
                    </group>
					<group col="4" colspan="4" attrs="{'invisible':[('state','=','send_type')]}">
                        <field name="preview_error" invisible="1"/>
                        <group col="4">
                            <label colspan="1" string=""/>
                            <field name="steps" widget="steps" colspan="2" nolabel="1"/>
                            <label colspan="1" string=""/>
                        </group>
                        <card title="Email settings" icon="settings" col="4" colspan="4" attrs="{'invisible':[('steps','!=','step1')]}">
                            <field name="rel_model" colspan="2" />
                            <field name="model_ref" colspan="2"/>
                            <field name="from" attrs="{'required':[('state','!=','send_type')]}" colspan="2" />
                            <field name="priority" colspan="2"/>
                            <field name="signature" widget="switch" colspan="4"/>
                        </card>
                        <group>
                            <card title="Message details" icon="mail" col="6" colspan="4" attrs="{'invisible':[('steps','!=','step1')]}">
                                <field name="to" select="1" colspan="4" />
                                <field name="cc" select="2" colspan="4" />
                                <field name="bcc" select="2" colspan="4" />
                                <field name="subject" select="2" colspan="4" attrs="{'required':[('state','=','single')]}" />
                                <field name="report" colspan="4" />
                            </card>
                            <card title="Additional template variables" icon="adjustments" colspan="4" attrs="{'invisible':[('steps','!=','step1')]}">
                                <field name="env" colspan="4" widget="codeeditor" widget_props="{'lang': 'json'}" height="100" nolabel="1"/>
                            </card>
                            <group attrs="{'invisible':[('steps','!=','step2')]}">
                                <notebook colspan="4">
                                    <page string="Email preview" icon="eye">
                                        <group>
                                            <field name="body_preview" colspan="2" widget="html_preview" nolabel="1"/>
                                            <field name="body_text" select="2" colspan="2" nolabel="1" height="550" on_change="onchange_body_text(body_text)"/>
                                        </group>
                                    </page>
                                    <page string="Attachments" icon="link">
                                        <label string="Add attachments from the current document to include in this email." colspan="4"/>
                                        <field name="attachment_ids" colspan="4" nolabel="1"/>
                                    </page>
                                    <page string="Status" icon="info-circle">
                                        <field name="state" />
                                        <label string="When sent, generated emails are placed in the Outbox and will be sent during the next Send/Receive." colspan="4"/>
                                        <label string="For multiple emails, the language of the first record is used. Send records in language-specific groups when needed." colspan="4"/>
                                        <field name="requested" />
                                        <field name="generated" />
                                    </page>
                                </notebook>
                            </group>
                        </group>
                        <group col="10" attrs="{'invisible':[('steps','!=','step1')]}">
                            <label colspan="6"/>
                            <button icon="gtk-cancel" danger="1" special="cancel" string="Discard Mail" colspan="2" />
                            <button icon="eye" name="preview_mail" string="Preview Email" type="object" colspan="2" />
                        </group>
                        <group col="10" attrs="{'invisible':[('steps','!=','step2')]}">
                            <label colspan="2"/>
                            <group colspan="4" attrs="{'invisible':[('preview_error','=',False)]}">
                                <label colspan="4" string=""/>
                            </group>
                            <group col="10" attrs="{'invisible':[('preview_error','=',False)]}">
                                <label colspan="6"/>
                                <button name="action_previous" string="Back" type="object" icon="arrow-left" colspan="2" />
                            </group>
                            <group col="4" colspan="4" attrs="{'invisible':[('preview_error','=',True)]}">
                                <group col="10" attrs="{'invisible':[('state','!=','single')]}">
                                    <label colspan="4"/>
                                    <button name="action_previous" string="Back" type="object" icon="arrow-left" colspan="2" />
                                    <button icon="device-floppy" name="sav_to_drafts" string="Save in Drafts" type="object" colspan="2" />
                                    <button icon="send" primary="1" name="send_mail" string="Send now" type="object" colspan="2" />
                                </group>
                                 <group col="10" attrs="{'invisible':[('state','!=','multi')]}">
                                     <label colspan="6"/>
                                     <button name="action_previous" string="Back" type="object" icon="arrow-left" colspan="2" />
                                     <button icon="send" name="get_generated" string="Send all mails" type="object" primary="1" colspan="2" />
                                 </group>
                            </group>

                        </group>
                    </group>
                </form>
			</field>
		</record>

        <record id="action_poweremail_template_preview" model="ir.actions.act_window">
            <field name="name">Preview Template</field>
            <field name="res_model">poweremail.send.wizard</field>
            <field name="src_model">poweremail.templates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="poweremail_send_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{'template_id': active_id}</field>
        </record>
	</data>
</openerp>

